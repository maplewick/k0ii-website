# Primary clan tracked by the API poller
CLAN_NAME=K0i2

# apps/api — Prisma Postgres (Accelerate URL in DATABASE_URL, direct URL for migrations)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_ACCELERATE_KEY"
DIRECT_DATABASE_URL="postgres://user:password@host:5432/k0ii"

# apps/api
API_PORT=3002

# Comma-separated browser origins for CORS. Localhost:3001 always allowed.
# No quotes / trailing slash. Use * to allow any origin (demo only).
# WEB_ORIGINS=https://web-rewrite.up.railway.app

# Free tier: 100k ops/month — fat headroom; live UI ~5 min lag
POLL_INTERVAL_MS=300000
POLL_INTERVAL_IDLE_MS=1800000
ROSTER_CACHE_MS=300000
CLAN_SNAPSHOT_WINDOW=10
CLAN_LADDER_FULL_EVERY=6
PLAYER_SNAP_FORCE_MS=900000

# Global player index (JSON file — 0 Accelerate ops). Live battle only.
GLOBAL_INDEX_CLAN_LIMIT=500
GLOBAL_INDEX_REFRESH_MS=1800000
GLOBAL_INDEX_FETCH_CONCURRENCY=6

# apps/web
NEXT_PUBLIC_API_URL=http://localhost:3002
# Railway: browser same-origin /api/* → Next route proxies to api (runtime env)
# API_UPSTREAM_URL=https://api-rewrite.up.railway.app
# NEXT_PUBLIC_API_SAME_ORIGIN=1
